# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# legacy root-level Next.js static export output
/_next/
/_not-found/
/404/
/404.html
/index.html
/index.txt
/__next.*.txt
/.nojekyll

# public assets copied into the root by the legacy export
/projects/
/screens/
/favicon.svg
/file.svg
/globe.svg
/og.png
/window.svg

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/
